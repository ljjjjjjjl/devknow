# ---- 密钥（绝对不能提交）----
.env
*.pem
*.key

# ---- 运行期数据目录 ----
data/*
data/**/

# 保留目录骨架
!data/.gitkeep
!data/README.md
!data/repos/
!data/repos/.gitkeep
!data/repos/README.md
!data/tmp/
!data/tmp/.gitkeep
!data/tmp/README.md
!data/logs/
!data/logs/.gitkeep
!data/logs/README.md

# ---- 构建产物 ----
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
logs/